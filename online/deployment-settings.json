{
  "description": "Settings saved on the Railway service via API; this is a reproducible record, not a Railway Config as Code file.",
  "runtime": "Dockerfile",
  "port": 8080,
  "persistentVolume": "/data",
  "serviceInstance": {
    "dockerfilePath": "Dockerfile",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "numReplicas": 1
  }
}
