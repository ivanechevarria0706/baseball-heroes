package com.bh.ui {
 import flash.display.*;import flash.events.Event;import flash.text.*;import flash.utils.getTimer;import com.bh.visual.TrainingArtwork;
 /** Non-blocking, bounded feedback. Counts describe this match, not invented career badges. */
 public class MatchFeedback extends Sprite {
  private var toast:Sprite=new Sprite(),tip:Sprite=new Sprite(),title:TextField,body:TextField,until:int=0;
  private var art:Bitmap;private var progressView:Sprite=new Sprite(),progressTitle:TextField,progressCount:TextField,progressBar:Shape=new Shape(),queue:Array=[],progressUntil:int=0;
  public function MatchFeedback(w:Number,h:Number){name="match-feedback";mouseEnabled=mouseChildren=false;addChild(toast);addChild(tip);toast.x=w-272;toast.y=192;toast.graphics.lineStyle(2,0x9ae2f4);toast.graphics.beginFill(0x155c8e,.95);toast.graphics.drawRoundRect(0,0,254,62,8);toast.graphics.endFill();title=text(toast,8,8,238,45,16);tip.x=18;tip.y=h-178;tip.graphics.lineStyle(2,0xffffff);tip.graphics.beginFill(0xf8fcf4,.96);tip.graphics.drawRoundRect(68,7,270,66,10);tip.graphics.endFill();art=TrainingArtwork.assistant();art.width=76;art.scaleY=art.scaleX;art.y=-21;tip.addChild(art);body=text(tip,80,14,247,55,12,0x315b72);toast.visible=tip.visible=false;progressView.name="match-achievement-progress";progressView.x=w-310;progressView.y=h-151;progressView.graphics.lineStyle(2,0xadcddd);progressView.graphics.beginFill(0x0a548a,.96);progressView.graphics.drawRoundRect(0,0,291,63,9);progressView.graphics.endFill();progressTitle=text(progressView,9,6,204,21,12);progressCount=text(progressView,193,6,89,21,12,0xffe65d);progressView.addChild(progressBar);progressView.visible=false;addChild(progressView);addEventListener(Event.ENTER_FRAME,frame);}
  private function text(p:Sprite,x:Number,y:Number,w:Number,h:Number,size:int,c:uint=0xffffff):TextField {var t:TextField=new TextField();t.defaultTextFormat=new TextFormat("Arial",size,c,true);t.wordWrap=true;t.selectable=false;t.x=x;t.y=y;t.width=w;t.height=h;p.addChild(t);return t;}
  public function show(value:String,advice:String=""):void {if(advice=="Termina el partido para guardar este avance.")return;title.text=value;body.text=advice;HelpText.fit(body,12,11);toast.visible=true;tip.visible=advice.length>0;until=getTimer()+Math.max(3100,Math.min(6000,advice.length*45));alpha=1;}
  public function progress(value:String,count:int,target:int):void {queue.push({title:value,count:Math.max(0,count),target:Math.max(1,target)});while(queue.length>4)queue.shift();if(!progressView.visible)nextProgress();}
  private function nextProgress():void {if(!queue.length){progressView.visible=false;return;}var item:Object=queue.shift();progressTitle.text=item.title;progressCount.text=item.count+" / "+item.target;progressBar.graphics.clear();progressBar.graphics.beginFill(0x12394e);progressBar.graphics.drawRoundRect(10,34,271,13,8);progressBar.graphics.endFill();progressBar.graphics.beginFill(0x9edc3e);progressBar.graphics.drawRoundRect(10,34,Math.max(2,271*Math.min(1,item.count/item.target)),13,8);progressBar.graphics.endFill();progressView.visible=true;progressView.alpha=1;progressUntil=getTimer()+1500;}
  private function frame(e:Event):void {var now:int=getTimer();if(progressView.visible){progressView.alpha=Math.min(1,Math.max(0,(progressUntil-now)/220));if(now>=progressUntil)nextProgress();}if(toast.visible){var left:int=until-now;toast.alpha=tip.alpha=Math.min(1,Math.max(0,left/400));if(left<=0)toast.visible=tip.visible=false;}}
  public function dispose():void {removeEventListener(Event.ENTER_FRAME,frame);if(art){art.bitmapData.dispose();art=null;}}
 }
}
